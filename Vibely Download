<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Vibely</title>

  <script src="https://unpkg.com/react@18/umd/react.development.js"></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

  <style>
    body { font-family: Arial; margin:0; background:#f3f4f6; }
    header { background:#6366f1; color:white; padding:15px; font-size:24px; }
    nav button { margin:5px; padding:8px 12px; }
    .card { background:white; margin:10px; padding:10px; border-radius:6px; }
    input, textarea, select { width:100%; padding:6px; margin:4px 0; }
    .chatbox { height:200px; overflow:auto; border:1px solid #ccc; padding:6px; }
  </style>
</head>
<body>
<div id="root"></div>

<script type="text/babel">

const { useState, useEffect } = React;
const ADMIN_PASS = "FactoryDudeCrew";

function App(){
  const [page,setPage]=useState("feed");
  const [users,setUsers]=useState(JSON.parse(localStorage.getItem("users"))||[]);
  const [current,setCurrent]=useState(JSON.parse(localStorage.getItem("current"))||null);
  const [posts,setPosts]=useState(JSON.parse(localStorage.getItem("posts"))||[]);
  const [messages,setMessages]=useState(JSON.parse(localStorage.getItem("messages"))||{});
  const [bans,setBans]=useState(JSON.parse(localStorage.getItem("bans"))||{});
  const [dark,setDark]=useState(false);

  useEffect(()=>localStorage.setItem("users",JSON.stringify(users)),[users]);
  useEffect(()=>localStorage.setItem("current",JSON.stringify(current)),[current]);
  useEffect(()=>localStorage.setItem("posts",JSON.stringify(posts)),[posts]);
  useEffect(()=>localStorage.setItem("messages",JSON.stringify(messages)),[messages]);
  useEffect(()=>localStorage.setItem("bans",JSON.stringify(bans)),[bans]);

  if(!current) return <Login users={users} setUsers={setUsers} setCurrent={setCurrent} bans={bans}/>;

  const isBanned=(u)=>bans[u] && Date.now()<bans[u];

  return(
    <div style={{background:dark?"#111":"#f3f4f6",minHeight:"100vh",color:dark?"white":"black"}}>
      <header>Vibely</header>
      <nav>
        <button onClick={()=>setPage("feed")}>Feed</button>
        <button onClick={()=>setPage("chat")}>Chat</button>
        <button onClick={()=>setPage("profile")}>Profile</button>
        <button onClick={()=>setPage("search")}>Search</button>
        <button onClick={()=>setPage("adminGate")}>Admin</button>
        <button onClick={()=>setDark(!dark)}>Dark Mode</button>
      </nav>

      {page==="feed" && <Feed posts={posts} setPosts={setPosts} current={current} isBanned={isBanned}/>}
      {page==="chat" && <Chat users={users} current={current} messages={messages} setMessages={setMessages}/>}
      {page==="profile" && <Profile current={current} setCurrent={setCurrent} users={users} setUsers={setUsers}/>}
      {page==="search" && <Search users={users}/>}
      {page==="adminGate" && <AdminGate setPage={setPage}/>}
      {page==="admin" && <Admin users={users} bans={bans} setBans={setBans}/>}
    </div>
  );
}

function Login({users,setUsers,setCurrent,bans}){
  const [name,setName]=useState("");
  const enter=()=>{
    if(bans[name] && Date.now()<bans[name]) return alert("Banned");
    let u=users.find(x=>x.username===name);
    if(!u){u={username:name,bio:"New here!"};setUsers([...users,u]);}
    setCurrent(u);
  };
  return(
    <div className="card">
      <h2>Login to Vibely</h2>
      <input onChange={e=>setName(e.target.value)} placeholder="Username"/>
      <button onClick={enter}>Enter</button>
    </div>
  );
}

function Feed({posts,setPosts,current,isBanned}){
  const [text,setText]=useState("");
  const post=()=>{
    if(isBanned(current.username)) return alert("Banned");
    setPosts([{id:Date.now(),author:current.username,text},...posts]);
    setText("");
  };
  return(
    <div className="card">
      <textarea value={text} onChange={e=>setText(e.target.value)}/>
      <button onClick={post}>Post</button>
      {posts.map(p=><div key={p.id}><b>{p.author}:</b> {p.text}</div>)}
    </div>
  );
}

function Chat({users,current,messages,setMessages}){
  const [to,setTo]=useState("Your AI Bot");
  const [text,setText]=useState("");
  const key=[current.username,to].sort().join("-");
  const chat=messages[key]||[];

  const send=()=>{
    let c=[...chat,{from:current.username,text}];
    if(to==="Your AI Bot") c.push({from:"Your AI Bot",text:"I am Your AI Bot 🤖"});
    setMessages({...messages,[key]:c});
    setText("");
  };

  return(
    <div className="card">
      <select onChange={e=>setTo(e.target.value)}>
        <option>Your AI Bot</option>
        {users.filter(u=>u.username!==current.username).map(u=>
          <option key={u.username}>{u.username}</option>
        )}
      </select>
      <div className="chatbox">
        {chat.map((m,i)=><div key={i}><b>{m.from}:</b> {m.text}</div>)}
      </div>
      <input value={text} onChange={e=>setText(e.target.value)}/>
      <button onClick={send}>Send</button>
    </div>
  );
}

function Profile({current,setCurrent,users,setUsers}){
  const [name,setName]=useState(current.username);
  const [bio,setBio]=useState(current.bio);
  const save=()=>{
    const u={...current,username:name,bio};
    setUsers(users.map(x=>x.username===current.username?u:x));
    setCurrent(u);
  };
  return(
    <div className="card">
      <input value={name} onChange={e=>setName(e.target.value)}/>
      <textarea value={bio} onChange={e=>setBio(e.target.value)}/>
      <button onClick={save}>Save</button>
    </div>
  );
}

function Search({users}){
  return(
    <div className="card">
      {users.map(u=><div key={u.username}>{u.username}</div>)}
    </div>
  );
}

function AdminGate({setPage}){
  const [c,setC]=useState("");
  return(
    <div className="card">
      <input placeholder="Passcode" onChange={e=>setC(e.target.value)}/>
      <button onClick={()=>c===ADMIN_PASS?setPage("admin"):alert("Wrong")}>Enter</button>
    </div>
  );
}

function Admin({users,bans,setBans}){
  const ban=(u,m)=>setBans({...bans,[u]:Date.now()+m*60000});
  const unban=(u)=>{let b={...bans};delete b[u];setBans(b);};

  return(
    <div className="card">
      {users.map(u=>
        <div key={u.username}>
          {u.username}
          <button onClick={()=>ban(u.username,5)}>Ban 5m</button>
          <button onClick={()=>ban(u.username,60)}>Ban 1h</button>
          <button onClick={()=>unban(u.username)}>Unban</button>
        </div>
      )}
    </div>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<App/>);

</script>
</body>
</html>
